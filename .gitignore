# OS
.DS_Store

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Python / data-processing
data-processing/.venv/
data-processing/__pycache__/
data-processing/**/__pycache__/
data-processing/**/*.pyc
data-processing/.pytest_cache/

# Source imaging data - never commit real patient-adjacent data
data-processing/raw/*
!data-processing/raw/.gitkeep
!data-processing/raw/README.md

# Generated intermediates - regenerate via the pipeline, don't version large binaries
data-processing/derived/*
!data-processing/derived/.gitkeep
!data-processing/derived/README.md

# Built case packages served to the frontend (generated by 06_export_case_package.py)
frontend/public/cases/*
!frontend/public/cases/.gitkeep
!frontend/public/cases/README.md

# Compiled AR targets (generated from targets/*.png via MindAR's compiler)
frontend/public/targets/*.mind

# Local browser verification artifacts
.playwright-cli/
output/playwright/
